DISCORD_TOKEN=put_your_new_rotated_bot_token_here
DISCORD_CLIENT_ID=put_your_discord_application_client_id_here

# Optional. Add this if you monitor private repositories or want a higher GitHub API limit.
GITHUB_TOKEN=

# Recommended on Railway. Add a PostgreSQL database and Railway will provide this.
DATABASE_URL=

# Optional. Default: 60
POLL_INTERVAL_SECONDS=60

# Optional profile / rich presence.
BOT_STATUS=online
BOT_PRESENCE_TEXT=GitHub Monitor
BOT_PRESENCE_REFRESH_SECONDS=45

# Optional file storage directory. Use this only if you run a single instance.
# On Railway with multiple instances, prefer DATABASE_URL instead.
# BOT_DATA_DIR=/data
BOT_DATA_DIR=
